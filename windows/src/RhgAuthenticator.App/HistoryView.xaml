<UserControl x:Class="RhgAuthenticator.App.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:RhgAuthenticator.ViewModels;assembly=RhgAuthenticator.ViewModels"
             Loaded="OnLoaded" Unloaded="OnUnloaded" SizeChanged="OnSizeChanged">
    <UserControl.Resources>
        <ResourceDictionary Source="TextStyles.xaml" />
    </UserControl.Resources>
    <DockPanel>
        <!-- The command row; the login button at its right end, docked first so it never clips. -->
        <DockPanel DockPanel.Dock="Top">
            <Button DockPanel.Dock="Right" Margin="0,16,24,16" ContentTemplate="{StaticResource CommandContent}"
                    Tag="&#xE77B;" Content="{Binding Login.ButtonTitle}"
                    AutomationProperties.Name="{Binding Login.ButtonTitle}"
                    Command="{Binding Login.ButtonCommand}" />
            <StackPanel Style="{StaticResource CommandRow}">
                <Button Style="{StaticResource AccentButtonStyle}" ContentTemplate="{StaticResource CommandContent}"
                        Tag="&#xE72C;" Content="{x:Static vm:HistoryViewModel.RefreshTitle}"
                        AutomationProperties.Name="{x:Static vm:HistoryViewModel.RefreshTitle}"
                        Command="{Binding RefreshCommand}" />
                <!-- Destructive, so never the accent; its confirmation is the ConfirmService's, defaulting to Cancel. -->
                <Button Margin="8,0,0,0" ContentTemplate="{StaticResource CommandContent}"
                        Tag="&#xE711;" Content="{x:Static vm:HistoryViewModel.RevokeTitle}"
                        AutomationProperties.Name="{x:Static vm:HistoryViewModel.RevokeTitle}"
                        Command="{Binding RevokeCommand}" />
                <Button Margin="8,0,0,0" ContentTemplate="{StaticResource CommandContent}"
                        Tag="&#xE78C;" Content="{x:Static vm:HistoryViewModel.ExportTitle}"
                        AutomationProperties.Name="{x:Static vm:HistoryViewModel.ExportTitle}"
                        Command="{Binding ExportIssuanceLogCommand}" />
                <Button Margin="8,0,0,0" ContentTemplate="{StaticResource CommandContent}"
                        Tag="&#xE74D;" Content="{x:Static vm:HistoryViewModel.RemoveDuplicatesTitle}"
                        AutomationProperties.Name="{x:Static vm:HistoryViewModel.RemoveDuplicatesTitle}"
                        Command="{Binding RemoveDuplicatesCommand}" />
            </StackPanel>
        </DockPanel>
        <!-- The panes' widths and minimums are set in code-behind (the constructor, FitPanes). -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ListColumn" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="DetailColumn" Width="*" />
            </Grid.ColumnDefinitions>

            <!-- The search, the records, the revocation list's state and the status line. -->
            <DockPanel Grid.Column="0" Margin="24,0,16,16">
                <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                    <TextBox x:Name="SearchBox" AutomationProperties.Name="{x:Static vm:HistoryViewModel.SearchPlaceholder}"
                             Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Style="{StaticResource Placeholder}" Text="{x:Static vm:HistoryViewModel.SearchPlaceholder}"
                               Visibility="{Binding Text, ElementName=SearchBox, Converter={StaticResource EmptyToVisibility}}" />
                </Grid>
                <TextBox DockPanel.Dock="Bottom" Margin="0,8,0,0" Style="{StaticResource SelectableText}"
                         Text="{Binding Status, Mode=OneWay}" />
                <TextBlock DockPanel.Dock="Bottom" Margin="0,12,0,0" TextWrapping="Wrap"
                           Foreground="{DynamicResource SystemFillColorCautionBrush}"
                           Text="{Binding RevocationStatus}"
                           Visibility="{Binding RevocationStatus, Converter={StaticResource NonEmptyToVisibility}}" />
                <!--
                  The records. Their rows are set in code-behind (from
                  Snapshot.Rows), the row index being what the view model
                  selects: duplicate rows are equal records. A long summary
                  trims (no sideways scrolling), its tooltip holding it whole.
                -->
                <ListBox x:Name="Records" SelectionMode="Single"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                         SelectionChanged="OnRecordsSelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock TextTrimming="CharacterEllipsis" Text="{Binding Summary}" ToolTip="{Binding Summary}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <!-- The divider: a 5 px drag (or arrow-key) handle around a 1 px line. -->
            <GridSplitter x:Name="Splitter" Grid.Column="1" Width="5" Margin="0,0,0,16" Background="Transparent" Cursor="SizeWE"
                          ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" />
            <Border Grid.Column="1" Width="1" Margin="0,0,0,16" IsHitTestVisible="False"
                    Background="{DynamicResource DividerStrokeColorDefaultBrush}" />

            <!-- The selected record's detail as the core words it. -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Visibility="{Binding SelectedDetail, Converter={StaticResource NonEmptyToVisibility}}">
                <TextBox Margin="24,0,24,16" Style="{StaticResource SelectableText}"
                         Text="{Binding SelectedDetail, Mode=OneWay}" />
            </ScrollViewer>
            <!-- The empty state, while no record's detail is shown. -->
            <TextBlock Grid.Column="2" Margin="24,0,24,16" HorizontalAlignment="Center" VerticalAlignment="Center"
                       TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                       Text="{x:Static vm:HistoryViewModel.EmptyDetailText}"
                       Visibility="{Binding SelectedDetail, Converter={StaticResource EmptyToVisibility}}" />
        </Grid>
    </DockPanel>
</UserControl>
