<Window x:Class="RhgAuthenticator.App.DeviceCodeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:RhgAuthenticator.ViewModels;assembly=RhgAuthenticator.ViewModels"
        Title="{x:Static vm:LoginViewModel.DeviceCodeTitle}"
        Width="440" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <ResourceDictionary Source="TextStyles.xaml" />
    </Window.Resources>
    <StackPanel Margin="20">
        <TextBlock TextWrapping="Wrap" Text="{x:Static vm:LoginViewModel.DeviceCodePromptText}" />
        <!-- Large and selectable, so it can be read off or copied by hand. -->
        <TextBox Margin="0,16,0,0" Style="{StaticResource SelectableText}" TextAlignment="Center"
                 FontSize="28" FontWeight="SemiBold"
                 AutomationProperties.Name="{x:Static vm:LoginViewModel.DeviceCodePromptText}"
                 Text="{Binding DeviceCode.UserCode, Mode=OneWay}" />
        <!--
          Open GitHub is the primary (Enter), disabled without a verification
          page. Cancel has no Command: it closes the window, and closing maps
          to the login's cancel (OnClosing).
        -->
        <StackPanel Margin="0,16,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="CopyButton" MinWidth="80" Content="{x:Static vm:LoginViewModel.CopyCodeTitle}"
                    Command="{Binding CopyCodeCommand}" />
            <Button x:Name="OpenButton" MinWidth="80" Margin="8,0,0,0" IsDefault="True" Style="{StaticResource AccentButtonStyle}"
                    Content="{x:Static vm:LoginViewModel.OpenGitHubTitle}" Command="{Binding OpenGitHubCommand}" />
            <Button MinWidth="80" Margin="8,0,0,0" IsCancel="True" Content="{x:Static vm:LoginViewModel.CancelTitle}" />
        </StackPanel>
    </StackPanel>
</Window>
