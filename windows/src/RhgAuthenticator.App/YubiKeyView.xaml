<UserControl x:Class="RhgAuthenticator.App.YubiKeyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:RhgAuthenticator.ViewModels;assembly=RhgAuthenticator.ViewModels">
    <UserControl.Resources>
        <ResourceDictionary Source="TextStyles.xaml" />
    </UserControl.Resources>
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Style="{StaticResource CommandRow}">
            <!-- CheckCommand is disabled while a check runs. -->
            <Button Style="{StaticResource AccentButtonStyle}" ContentTemplate="{StaticResource CommandContent}"
                    Tag="&#xE8D7;" Content="{x:Static vm:YubiKeyViewModel.CheckTitle}"
                    AutomationProperties.Name="{x:Static vm:YubiKeyViewModel.CheckTitle}"
                    Command="{Binding CheckCommand}" />
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="24,0,24,16">
                <TextBox Style="{StaticResource SelectableText}" Text="{Binding Status, Mode=OneWay}" />
                <!-- The key's details as the core gives them, one per line; no card until there are some. -->
                <Border Margin="0,12,0,0" Padding="12" BorderThickness="1"
                        CornerRadius="{DynamicResource ControlCornerRadius}"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Details, Converter={StaticResource JoinLines}}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBox Style="{StaticResource SelectableText}"
                             Text="{Binding Details, Mode=OneWay, Converter={StaticResource JoinLines}}" />
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
