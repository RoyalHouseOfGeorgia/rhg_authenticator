<Window x:Class="RhgAuthenticator.App.BulkDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:RhgAuthenticator.ViewModels;assembly=RhgAuthenticator.ViewModels"
        Title="{Binding DialogTitle}"
        Width="560" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="TextStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="Heading" TargetType="TextBlock">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <!--
      One content per phase. Buttons whose role is Enter or Escape (IsDefault,
      IsCancel) have no Command: they close the window, and closing maps to
      the phase's command (OnClosing). Their phases never overlap, so at most
      one of each is enabled.
    -->
    <Grid Margin="20">
        <!-- Confirm: the plan's counts, the first names to be signed, the invalid rows to skip. -->
        <StackPanel Visibility="{Binding IsConfirming, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Style="{StaticResource Heading}" Text="{x:Static vm:BulkViewModel.Title}" />
            <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Text="{Binding Plan.CountsLine}" />
            <TextBlock Margin="0,8,0,0" Text="{x:Static vm:BulkViewModel.PreviewHeading}" />
            <ItemsControl Margin="16,4,0,0" ItemsSource="{Binding Plan.PreviewNames}" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock TextWrapping="Wrap" Text="{Binding}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel Margin="0,8,0,0" Visibility="{Binding HasInvalidLines, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Margin="0,0,0,4" Text="{x:Static vm:BulkViewModel.InvalidToSkipHeading}" />
                <TextBox Style="{StaticResource RowList}" AutomationProperties.Name="{x:Static vm:BulkViewModel.InvalidToSkipHeading}"
                         Text="{Binding Plan.InvalidLines, Mode=OneWay, Converter={StaticResource JoinLines}}" />
            </StackPanel>
            <StackPanel Margin="0,16,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button MinWidth="80" IsCancel="True" Content="{x:Static vm:BulkViewModel.CancelTitle}"
                        IsEnabled="{Binding IsConfirming}" />
                <Button x:Name="SignButton" MinWidth="80" Margin="8,0,0,0" IsDefault="True"
                        Content="{x:Static vm:BulkViewModel.SignTitle}" Command="{Binding ConfirmCommand}" />
            </StackPanel>
        </StackPanel>

        <!-- Progress: the bar, the row being signed, and Cancel (stops after the current row). The PIN prompt stacks on top. -->
        <StackPanel Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Style="{StaticResource Heading}" Text="{x:Static vm:BulkViewModel.Title}" />
            <ProgressBar Margin="0,12,0,0" Minimum="0" Maximum="1" Value="{Binding ProgressFraction, Mode=OneWay}" />
            <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" Text="{Binding ProgressLabel}" />
            <Button x:Name="CancelRunButton" Margin="0,16,0,0" MinWidth="80" HorizontalAlignment="Right"
                    Content="{x:Static vm:BulkViewModel.CancelTitle}" Command="{Binding CancelRunCommand}" />
        </StackPanel>

        <!-- Results: the summary, why the run stopped, the failed and skipped rows, Export Results CSV… and Close. -->
        <StackPanel Visibility="{Binding IsShowingResults, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Style="{StaticResource Heading}" Text="{x:Static vm:BulkViewModel.ResultsTitle}" />
            <TextBox Margin="0,8,0,0" Style="{StaticResource SelectableText}" Text="{Binding Outcome.SummaryLine, Mode=OneWay}" />
            <TextBox Margin="0,8,0,0" Style="{StaticResource SelectableText}" Text="{Binding Outcome.StopMessage, Mode=OneWay}"
                     Visibility="{Binding Outcome.StopMessage, Converter={StaticResource NonEmptyToVisibility}}" />
            <StackPanel Margin="0,8,0,0" Visibility="{Binding HasFailedLines, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Margin="0,0,0,4" Text="{x:Static vm:BulkViewModel.FailedHeading}" />
                <TextBox Style="{StaticResource RowList}" AutomationProperties.Name="{x:Static vm:BulkViewModel.FailedHeading}"
                         Text="{Binding Outcome.FailedLines, Mode=OneWay, Converter={StaticResource JoinLines}}" />
            </StackPanel>
            <StackPanel Margin="0,8,0,0" Visibility="{Binding HasInvalidLines, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Margin="0,0,0,4" Text="{x:Static vm:BulkViewModel.InvalidSkippedHeading}" />
                <TextBox Style="{StaticResource RowList}" AutomationProperties.Name="{x:Static vm:BulkViewModel.InvalidSkippedHeading}"
                         Text="{Binding Plan.InvalidLines, Mode=OneWay, Converter={StaticResource JoinLines}}" />
            </StackPanel>
            <Button Margin="0,12,0,0" HorizontalAlignment="Left"
                    Content="{x:Static vm:BulkViewModel.ExportTitle}" Command="{Binding ExportResultsCommand}" />
            <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Text="{x:Static vm:BulkViewModel.RegenerateNote}" />
            <Button x:Name="CloseButton" Margin="0,16,0,0" MinWidth="80" HorizontalAlignment="Right"
                    IsDefault="True" IsCancel="True" Content="{x:Static vm:BulkViewModel.CloseTitle}"
                    IsEnabled="{Binding IsShowingResults}" />
        </StackPanel>
    </Grid>
</Window>
