<Window x:Class="RhgAuthenticator.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RhgAuthenticator.App"
        xmlns:vm="clr-namespace:RhgAuthenticator.ViewModels;assembly=RhgAuthenticator.ViewModels"
        Title="{x:Static vm:AppViewModel.WindowTitle}"
        Icon="app.ico"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="OnPreviewKeyDown">
    <!--
      F5 refreshes the shown tab, as its Refresh (or Fetch) button does; nothing
      on a tab without one. Ctrl+F is added by HistoryView while it is shown
      (ApplicationCommands.Find).
    -->
    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshTabCommand}" />
    </Window.InputBindings>
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:SignViewModel}">
            <local:SignView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:HistoryViewModel}">
            <local:HistoryView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:RegistryViewModel}">
            <local:RegistryView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AuditViewModel}">
            <local:AuditView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:YubiKeyViewModel}">
            <local:YubiKeyView />
        </DataTemplate>
        <!-- The Help tab's content is the app's own view model. -->
        <DataTemplate DataType="{x:Type vm:AppViewModel}">
            <local:HelpView />
        </DataTemplate>

        <!--
          Office-style tab headers: text only, no border, the selected one
          underlined in the accent colour. Not based on the Fluent TabItem
          style (its template is replaced whole), so the brushes and focus
          visual are set here.
        -->
        <Style x:Key="TabHeader" TargetType="TabItem">
            <Setter Property="Header" Value="{Binding Title}" />
            <Setter Property="IsEnabled" Value="{Binding IsEnabled}" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <!-- Not null: a null background takes no mouse, so hover would never show. -->
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="4"
                                Padding="12,8,12,0" SnapsToDevicePixels="True">
                            <StackPanel>
                                <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"
                                                  HorizontalAlignment="Center" />
                                <Border x:Name="Underline" Height="3" Margin="0,6,0,0" CornerRadius="1.5"
                                        Background="{DynamicResource AccentFillColorDefaultBrush}" Visibility="Hidden" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                <Setter TargetName="Underline" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
          The tab row flush under the title bar, the window-wide update
          banner (while there is an update), a divider, then the selected
          tab. The KeyboardNavigation settings are the stock template's (Tab
          reaches the row once, the arrow keys move between tabs), with the
          banner's link between the row and the tab.
        -->
        <ControlTemplate x:Key="TabRow" TargetType="TabControl">
            <Grid KeyboardNavigation.TabNavigation="Local" SnapsToDevicePixels="True">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TabPanel Grid.Row="0" Margin="12,4,12,0" IsItemsHost="True" KeyboardNavigation.TabIndex="1" />
                <!--
                  The update banner, full width; collapsed without an update.
                  Its DataContext is the TabControl's, the AppViewModel. The
                  link opens the release page only through OpenReleaseCommand,
                  which checks the URL and reports a failure; never NavigateUri.
                -->
                <Border x:Name="BannerSlot" Grid.Row="1" Focusable="False" Padding="24,12"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        KeyboardNavigation.TabNavigation="Local" KeyboardNavigation.TabIndex="2"
                        Visibility="{Binding UpdateBanner, Converter={StaticResource NullToVisibility}}">
                    <TextBlock TextWrapping="Wrap">
                        <Run Text="{Binding UpdateBanner.Text, Mode=OneWay}" />
                        <Hyperlink Command="{Binding OpenReleaseCommand}"
                                   AutomationProperties.Name="{x:Static vm:UpdateBanner.DownloadTitle}"><Run Text="{x:Static vm:UpdateBanner.DownloadTitle}" /></Hyperlink>
                    </TextBlock>
                </Border>
                <Border Grid.Row="2" Height="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
                <ContentPresenter x:Name="PART_SelectedContentHost" Grid.Row="3" ContentSource="SelectedContent"
                                  KeyboardNavigation.TabNavigation="Local"
                                  KeyboardNavigation.DirectionalNavigation="Contained"
                                  KeyboardNavigation.TabIndex="3" />
            </Grid>
        </ControlTemplate>
    </Window.Resources>
    <DockPanel>
        <!-- The status bar: the core's items spread across the window, shown once the core is ready. -->
        <StackPanel x:Name="StatusBarArea" DockPanel.Dock="Bottom" Visibility="Collapsed">
            <Border Height="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
            <Grid x:Name="StatusBar" Margin="24,6" />
        </StackPanel>
        <!-- In every phase; the view model enables the tabs and selects one by phase. ItemsSource before SelectedItem. -->
        <TabControl Template="{StaticResource TabRow}" ItemContainerStyle="{StaticResource TabHeader}"
                    ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab, Mode=TwoWay}">
            <TabControl.ContentTemplate>
                <DataTemplate DataType="{x:Type vm:AppTab}">
                    <ContentControl Content="{Binding Content}" Focusable="False" />
                </DataTemplate>
            </TabControl.ContentTemplate>
        </TabControl>
    </DockPanel>
</Window>
