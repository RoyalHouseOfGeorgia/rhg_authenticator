  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/RhgAuthenticator.ViewModels/RhgAuthenticator.ViewModels.csproj" />
  </ItemGroup>
</Project>
