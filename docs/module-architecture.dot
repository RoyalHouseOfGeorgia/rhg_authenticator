digraph module_architecture {
    rankdir=TB;
    bgcolor="transparent";
    node [fontname="Helvetica", fontsize=10, style="filled,rounded", shape=box, penwidth=1.2];
    edge [color="#868e96", penwidth=0.8];
    compound=true;

    // TypeScript verification library
    subgraph cluster_ts {
        label="TypeScript — Verification Library";
        labeljust=l;
        style="dashed,rounded";
        color="#4263eb";
        fontname="Helvetica";
        fontsize=10;
        fontcolor="#4263eb";

        index [label="index.ts\n(barrel export)", fillcolor="#dbe4ff", color="#4263eb"];
        verify [label="verify.ts\n(orchestrator)", fillcolor="#dbe4ff", color="#4263eb"];
        verify_page [label="verify-page.ts\n(browser UI)", fillcolor="#dbe4ff", color="#4263eb"];
        credential [label="credential.ts\n(schema + sanitize)", fillcolor="#dbe4ff", color="#4263eb"];
        crypto [label="crypto.ts\n(Ed25519)", fillcolor="#dbe4ff", color="#4263eb"];
        registry [label="registry.ts\n(key registry)", fillcolor="#dbe4ff", color="#4263eb"];
        revocation [label="revocation.ts\n(revocation list)", fillcolor="#dbe4ff", color="#4263eb"];
        validation [label="validation.ts\n(date utils)", fillcolor="#dbe4ff", color="#4263eb"];
        base64url [label="base64url.ts\n(encoding)", fillcolor="#dbe4ff", color="#4263eb"];
        canonical [label="canonical.ts\n(JSON serializer)", fillcolor="#dbe4ff", color="#4263eb"];
    }

    // Native desktop apps (front ends over the Go core's C ABI)
    subgraph cluster_hosts {
        label="Native Apps";
        labeljust=l;
        style="dashed,rounded";
        color="#7048e8";
        fontname="Helvetica";
        fontsize=10;
        fontcolor="#7048e8";

        mac_views [label="RHGAuthenticator\n(SwiftUI views, macOS)", fillcolor="#e5dbff", color="#7048e8"];
        mac_models [label="RHGModels\n(app + tab models)", fillcolor="#e5dbff", color="#7048e8"];
        mac_bridge [label="RHGBridge\n(Swift bridge)", fillcolor="#e5dbff", color="#7048e8"];
        win_app [label="RhgAuthenticator.App\n(WPF views, Windows)", fillcolor="#e5dbff", color="#7048e8"];
        win_vm [label="RhgAuthenticator.ViewModels", fillcolor="#e5dbff", color="#7048e8"];
        win_bridge [label="RhgAuthenticator.Bridge\n(P/Invoke bridge)", fillcolor="#e5dbff", color="#7048e8"];
    }

    // Go core library
    subgraph cluster_go {
        label="Go — Core Library (librhgcore.a / rhgcore.dll)";
        labeljust=l;
        style="dashed,rounded";
        color="#e67700";
        fontname="Helvetica";
        fontsize=10;
        fontcolor="#e67700";

        go_rhgcore [label="cmd/rhgcore/\n(C ABI: RHGCall, RHGFree,\nRHGSetEventCallback,\nRHGMainCLI)", fillcolor="#ffe8cc", color="#e67700"];
        go_rpc [label="service/rpc/\n(JSON dispatch, lifecycle,\nPIN bridge, events)", fillcolor="#ffe8cc", color="#e67700"];
        go_service [label="service/\n(App: all feature logic\nand user-facing text)", fillcolor="#ffe8cc", color="#e67700"];
        go_host [label="host/\n(start-up: data dir,\nlogs, update config, CLI)", fillcolor="#ffe8cc", color="#e67700"];
        go_bulk [label="bulk/\n(CSV bulk signing)", fillcolor="#fff3bf", color="#e67700"];
        go_core [label="core/\n(credential, canonical,\nregistry, sign)", fillcolor="#fff3bf", color="#e67700"];
        go_ghapi [label="ghapi/\n(GitHub OAuth +\nREST API)", fillcolor="#fff3bf", color="#e67700"];
        go_yubikey [label="yubikey/\n(piv-go PIV adapter\n+ PIN cache)", fillcolor="#fff3bf", color="#e67700"];
        go_qr [label="qr/\n(SVG + PNG)", fillcolor="#fff3bf", color="#e67700"];
        go_log [label="log/\n(issuance log)", fillcolor="#fff3bf", color="#e67700"];
        go_registry [label="registry/\n(remote fetch)", fillcolor="#fff3bf", color="#e67700"];
        go_debuglog [label="debuglog/\n(error log,\n30-day retention)", fillcolor="#fff3bf", color="#e67700"];
        go_errorreport [label="errorreport/\n(Report Issue)", fillcolor="#fff3bf", color="#e67700"];
        go_update [label="update/\n(check, download, verify,\ninstall on quit)", fillcolor="#fff3bf", color="#e67700"];
        go_buildinfo [label="buildinfo/\n(version)", fillcolor="#fff3bf", color="#e67700"];
        go_safego [label="safego/\n(panic-safe\ngoroutines)", fillcolor="#fff3bf", color="#e67700"];
    }

    // External deps
    noble [label="@noble/curves\n(Ed25519)", shape=component, fillcolor="#d3f9d8", color="#2b8a3e"];
    pivgo [label="piv-go\n(PCSC)", shape=component, fillcolor="#d3f9d8", color="#2b8a3e"];
    qrcode [label="go-qrcode\n(QR encoding)", shape=component, fillcolor="#d3f9d8", color="#2b8a3e"];
    keyring [label="go-keyring\n(OS keychain)", shape=component, fillcolor="#d3f9d8", color="#2b8a3e"];

    // Cross-language link
    vectors [label="Cross-language\ntest vectors", shape=note, fillcolor="#e9ecef", color="#868e96"];

    // TypeScript core deps
    index -> verify;
    index -> registry;
    index -> credential;
    index -> crypto;
    index -> base64url;
    index -> canonical;
    verify -> credential;
    verify -> crypto;
    verify -> registry;
    verify -> revocation;
    verify_page -> verify;
    verify_page -> base64url;
    verify_page -> registry;
    verify_page -> revocation;
    credential -> validation;
    registry -> base64url;
    registry -> credential;
    registry -> validation;
    revocation -> credential;
    revocation -> validation;
    crypto -> noble;

    // Native apps -> C ABI
    mac_views -> mac_models;
    mac_models -> mac_bridge;
    mac_bridge -> go_rhgcore [label="C ABI\n(static link)"];
    win_app -> win_vm;
    win_vm -> win_bridge;
    win_bridge -> go_rhgcore [label="C ABI\n(embedded DLL)"];
    mac_views -> mac_bridge [style=dashed, label="result types"];
    win_app -> win_bridge [style=dashed, label="loader,\nsingle instance"];

    // Go internal deps (from the non-test import blocks; core is imported by nearly every package)
    go_rhgcore -> go_rpc;
    go_rhgcore -> go_host;
    go_rpc -> go_service;
    go_rpc -> go_host;
    go_rpc -> go_update;
    go_rpc -> go_ghapi;
    go_rpc -> go_debuglog;
    go_rpc -> go_safego;
    go_rpc -> go_core;
    go_host -> go_service;
    go_host -> go_update;
    go_host -> go_registry;
    go_host -> go_ghapi;
    go_host -> go_debuglog;
    go_host -> go_safego;
    go_host -> go_buildinfo;
    go_host -> go_core;
    go_service -> go_core;
    go_service -> go_bulk;
    go_service -> go_log;
    go_service -> go_qr;
    go_service -> go_registry;
    go_service -> go_yubikey;
    go_service -> go_ghapi;
    go_service -> go_errorreport;
    go_service -> go_debuglog;
    go_service -> go_buildinfo;
    go_service -> go_safego;
    go_qr -> go_core;
    go_bulk -> go_core;
    go_log -> go_core;
    go_registry -> go_core;
    go_ghapi -> go_core;
    go_debuglog -> go_core;
    go_update -> go_core;
    go_errorreport -> go_core;
    go_errorreport -> go_ghapi;
    go_yubikey -> pivgo;
    go_qr -> qrcode;
    go_ghapi -> keyring;

    // Cross-language
    go_core -> vectors [style=dotted, dir=both, label="byte-identical\noutput"];
    canonical -> vectors [style=dotted, dir=both];
}
